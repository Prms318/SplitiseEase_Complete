# Copy this file to .env and fill in your own local values
# .env itself must NEVER be committed (already in .gitignore)

# --- Postgres ---
POSTGRES_DB=splitease
POSTGRES_USER=splitease_user
POSTGRES_PASSWORD=devpassword
POSTGRES_PORT=5432

# --- pgAdmin ---
PGADMIN_EMAIL=admin@splitease.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- API ---
API_PORT=8000
SECRET_KEY=change-this-to-a-random-string-per-developer
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
